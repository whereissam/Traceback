# ---------------------------------------------------------------------------
# Traceback — API server configuration. Copy to `.env` and fill in.
# `.env` is gitignored; never commit real keys.
#
# WHY THERE IS NO `VITE_` PREFIX HERE
#
# Vite only exposes variables that start with `VITE_` to client code — and it
# does so by INLINING THEM INTO THE JAVASCRIPT BUNDLE at build time. A `VITE_`
# variable is not a secret: it ships to every visitor and is readable with
# view-source. That is correct for public values (a public anon key, an
# analytics id) and catastrophic for the keys below.
#
# Every variable in this file is read by the API server (`server/env.ts`) via
# `process.env`. Bun loads `.env` automatically when you run `bun run dev:server`.
# The browser never sees them; it talks only to `/api/*`, which Vite proxies to
# the API server in dev.
#
# Rule of thumb: if leaking it would cost money or grant access, it must NOT be
# `VITE_`-prefixed, and it must be used server-side only.
# ---------------------------------------------------------------------------

# Port for the Hono API server. Vite proxies /api here in dev.
PORT=8787

# --- Supabase (required) ---------------------------------------------------
# In the dashboard: Connect -> Server. That panel offers four variables because
# it assumes you are verifying end-user logins. Traceback has no user auth yet,
# so it needs only these two:
#
#   SUPABASE_URL            <- copy as-is
#   SUPABASE_SECRET_KEY     <- the `sb_secret_...` value
#
# Ignore the other two for now:
#   SUPABASE_PUBLISHABLE_KEY  (`sb_publishable_...`, formerly the `anon` key) —
#     public by design, meant for browser clients. Traceback's browser code
#     never talks to Supabase, so nothing would use it.
#   SUPABASE_JWKS_URL — public keys for verifying end-user JWTs. Needed only
#     once you add sign-in.
#
# The secret key bypasses Row Level Security. That is exactly why it stays on
# the server and never gets a VITE_ prefix.
#
# Older projects issue a JWT `service_role` key instead of `sb_secret_...`;
# either works — set SUPABASE_SERVICE_ROLE_KEY in that case.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# --- Modal (optional) ------------------------------------------------------
# Deploy with: modal deploy modal/modal_sim.py
# That prints the URL for `run_simulation`. Create the shared secret with:
#   modal secret create traceback-sim SIM_TOKEN=<random string>
# Leave both blank to run on locally generated telemetry instead. The UI states
# which source produced the data, so a fallback run is never mistaken for a
# real sandbox run.
MODAL_SIMULATE_URL=
# Real-package inspection (modal/inspect_package.py)
MODAL_INSPECT_URL=
MODAL_SIMULATE_TOKEN=

# --- OpenAI (optional) -----------------------------------------------------
# Used only to arrange already-derived findings into a timeline and draft the
# report. Without it the deterministic rule engine produces the timeline and the
# system still works end to end.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Reasoning depth: low | medium | high.
# `low` measured ~8s vs ~48s for `medium`, with the same timeline structure.
OPENAI_EFFORT=low
